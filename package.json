{
  "name": "dsh-runtime-env-watch",
  "version": "0.1.0",
  "description": "Timestamped AI runtime-environment audits for DeepSeek Harness: cwd, Git, key files, toolchain, and change detection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && pnpm run build && node test/runtime.test.mjs && node test/wiring.test.mjs",
    "prepare": "pnpm run build",
    "test": "pnpm run build && node test/runtime.test.mjs && node test/wiring.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.0.0",
    "tsdown": "0.15.12",
    "typescript": "^5.7.0",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2"
  },
  "packageManager": "pnpm@11.19.0",
  "license": "MIT"
}
